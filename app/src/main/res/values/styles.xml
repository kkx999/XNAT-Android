<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F6F9FD</item>
        <item name="android:navigationBarColor">#F6F9FD</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">#166FFF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F6F9FD</item>
    </style>

    <style name="XnatBottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/xnat_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/xnat_sheet_out</item>
    </style>
</resources>
